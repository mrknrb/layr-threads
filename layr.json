{
  "id": "claude",
  "name": "Claude Code",
  "version": "0.3.15",
  "description": "Claude Code threads in your projects and worktrees, and on your layr plugins and Chrome extensions, with approvals and live streaming.",
  "author": "mrknrb",
  "layr": "^0.1",
  "icon": "smart_toy",
  "permissions": ["data", "pc", "agents", "packages", "events:global"],
  "needs": ["pc", "node", "claude-code"],
  "connections": [
    { "plugin": "pipeline", "groups": ["thread"],
      "why": "In a pipeline task's thread: the task's buttons, and your messages and answers go through the pipeline" },
    { "plugin": "concepts", "groups": ["read"],
      "why": "Shows the concept nodes a thread touched, and the prototype pages linked in its replies" }
  ],
  "panels": [
    { "id": "threads", "title": "Claude threads", "page": "panels/threads.html", "icon": "forum", "single": true },
    { "id": "thread", "title": "Claude thread", "page": "panels/thread.html", "icon": "chat" },
    { "id": "build-times", "title": "Build times", "page": "panels/buildtimes.html", "icon": "timer", "single": true }
  ],
  "commands": [
    { "id": "threads", "title": "Claude threads", "panel": "threads" },
    { "id": "new-thread", "title": "New Claude thread", "panel": "threads", "params": { "new": true } },
    { "id": "build-times", "title": "Build times", "panel": "build-times" },
    { "id": "make-plugin", "title": "New plugin with Claude", "panel": "threads",
      "params": { "new": true, "target": "plugin", "plugin": "new" } },
    { "id": "new-extension", "title": "New Chrome extension with Claude", "panel": "threads",
      "params": { "new": true, "target": "extension", "plugin": "new" } }
  ],
  "menus": [
    { "menu": "Claude", "command": "new-thread", "group": "1" },
    { "menu": "Claude", "command": "threads", "group": "1" },
    { "menu": "Claude", "command": "build-times", "group": "1" },
    { "menu": "Claude", "command": "make-plugin", "group": "2" },
    { "menu": "Claude", "command": "new-extension", "group": "2" },
    { "menu": "Tools", "command": "make-plugin", "group": "9" }
  ],
  "keybindings": [ { "key": "ctrl+alt+t", "command": "threads" } ],
  "links": [ { "path": "thread", "panel": "thread", "param": "thread" } ],
  "settings": [
    { "id": "notifications", "type": "boolean", "title": "Notify when a thread finishes or needs you",
      "description": "Not for archived threads, nor for background ones (permission mode dontAsk).", "default": true },
    { "id": "repairConfig", "type": "boolean", "title": "Repair an empty ~/.claude.json",
      "description": "Claude Code's settings file is sometimes left empty while many Claude Codes run, and none can start then. Threads always wait and try again; with this on, layr also puts back Claude Code's newest backup (at most a day old), only while the file has been empty for 30 s.",
      "default": false }
  ],
  "backend": {
    "kind": "process",
    "runtime": "node",
    "entry": "backend/server.js",
    "keepAlive": true
  },
  "access": {
    "groups": [
      { "id": "read", "label": "See projects, threads' status, models and usage",
        "tools": ["projects_list", "worktrees_list", "thread_list", "thread_status", "thread_wait", "approvals_list",
                  "models_list", "usage", "plugins_folder", "thread_changes", "thread_commands", "targets_list"],
        "events": ["claude:threads", "claude:usage"],
        "defaults": { "plugins": "allow" } },
      { "id": "conversations", "label": "Read what threads say",
        "tools": ["thread_read", "thread_transcript", "thread_subagent", "attachment_read", "thread_diff"],
        "events": ["claude:thread.*"],
        "defaults": { "plugin:pipeline": "allow" } },
      { "id": "ask", "label": "Ask Claude one-off questions (uses your plan)", "tools": ["ask"],
        "defaults": { "plugin:pipeline": "allow", "plugin:concepts": "allow" } },
      { "id": "run", "label": "Start, steer and stop threads; change projects",
        "tools": ["thread_start", "thread_send", "thread_interrupt", "thread_retry", "thread_go_back", "thread_archive",
                  "thread_queue", "project_add", "project_update", "project_remove", "plugin_make", "thread_restore_workspace"],
        "defaults": { "plugin:pipeline": "allow", "plugin:devtools": "allow", "plugin:care": "allow" } },
      { "id": "approve", "label": "Answer threads' permission requests and change their permissions",
        "tools": ["answer_approval", "thread_update"], "events": ["claude:approval"],
        "defaults": { "plugin:pipeline": "allow" } },
      { "id": "build-times", "label": "See how long the builds, tests and checks threads run take",
        "tools": ["build_times", "build_times_import"],
        "defaults": { "plugins": "allow", "agents": "allow" } },
      { "id": "pc", "label": "Open terminal windows running commands, and folders, on your PC",
        "tools": ["run_in_terminal", "open_folder"] }
    ]
  }
}
