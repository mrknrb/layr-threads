{
  "id": "claude",
  "name": "Claude Code",
  "version": "0.1.0",
  "description": "Claude Code threads in your projects and worktrees, with approvals, live streaming, and plugins made with AI.",
  "author": "mrknrb",
  "layr": "^0.1",
  "icon": "smart_toy",
  "permissions": ["data", "pc", "agents", "packages", "plugins:*", "events:global"],
  "needs": ["pc", "node", "claude-code"],
  "panels": [
    { "id": "threads", "title": "Claude threads", "page": "panels/threads.html", "icon": "forum", "single": true },
    { "id": "thread", "title": "Claude thread", "page": "panels/thread.html", "icon": "chat" },
    { "id": "new-plugin", "title": "Make a plugin with AI", "page": "panels/new-plugin.html", "icon": "auto_fix_high",
      "single": true }
  ],
  "commands": [
    { "id": "threads", "title": "Claude threads", "panel": "threads" },
    { "id": "new-thread", "title": "New Claude thread", "panel": "threads", "params": { "new": true } },
    { "id": "make-plugin", "title": "Make a plugin with AI", "panel": "new-plugin" }
  ],
  "menus": [
    { "menu": "Claude", "command": "new-thread", "group": "1" },
    { "menu": "Claude", "command": "threads", "group": "1" },
    { "menu": "Claude", "command": "make-plugin", "group": "2" },
    { "menu": "Tools", "command": "make-plugin", "group": "9" }
  ],
  "keybindings": [ { "key": "ctrl+alt+t", "command": "threads" } ],
  "backend": {
    "kind": "process",
    "runtime": "node",
    "entry": "backend/server.js",
    "keepAlive": true
  }
}
